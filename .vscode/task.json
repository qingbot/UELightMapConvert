{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake配置",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-S", ".",
                "-G", "Visual Studio 16 2019",
                "-A", "x64"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake构建",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$msCompile",
            "dependsOn": [
                "CMake配置"
            ]
        },
        {
            "label": "运行Python测试",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/CPP/python_example.py"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "dependsOn": [
                "CMake构建"
            ]
        },
        {
            "label": "清理构建目录",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "clean"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}